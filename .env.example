# Pi-Esp Jarvis settings. setup.sh copies this to .env and asks the important questions.
# After editing .env, apply the changes with:  docker compose up -d

# --- Claude (used when you say "use Claude ..." and for live web answers) ---
# Get a key at https://console.anthropic.com/  (leave empty to run fully local)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Local model (everything else) ---
LOCAL_MODEL=llama3.2:3b

# --- Voice ---
ASSISTANT_NAME=Jarvis
WHISPER_MODEL=base.en
PIPER_VOICE=en_US-lessac-medium
SPEECH_SPEED=1.0

# --- Music ---
# Folder on the Pi with your music files (mp3, flac, m4a, ogg...). Optional:
# without it, "play ..." uses internet radio.
MUSIC_FOLDER=./music
# What a plain "play music" plays when the music folder is empty:
DEFAULT_RADIO_GENRE=soul
# Music loudness relative to the voice (0.1 - 1.0):
MUSIC_GAIN=0.6

# --- Everyday skills ---
# Your town for weather and the morning briefing, e.g. "London, GB" or "Austin, US"
# (leave empty to guess from your internet connection)
WEATHER_LOCATION=
# metric (°C, km/h), uk (°C, mph) or imperial (°F, mph)
WEATHER_UNITS=metric
# News for "what's the news" and the briefing (comma-separated RSS feeds)
NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml
# Let Claude search the web, and send obviously "live" questions (scores, prices, news about...) to it automatically
CLAUDE_WEB_SEARCH=true
AUTO_WEB_SEARCH=true
# Say the morning briefing when you stop a morning alarm
BRIEFING_AFTER_ALARM=true

# --- Camera (optional USB webcam: "what do you see?", "look left") ---
# To turn it on, uncomment both lines (setup.sh does this if it finds a camera).
# CAMERA_DEVICE is the camera on the Pi; see:  ls /dev/v4l/by-id/
# COMPOSE_FILE=docker-compose.yml:docker-compose.camera.yml
# CAMERA_DEVICE=/dev/video0
# CAMERA_RESOLUTION=960x720   # photo size sent to Claude
# CAMERA_PAN_INVERT=false     # true if "look left" turns right

# --- Voice notes ("Jarvis, go into voice notes", "take a note") ---
# Notes land in this folder on the Pi: YYYYMMDDHHMMSS.ogg + .txt transcript (local Whisper).
NOTES_FOLDER=./voice-notes
# true = Claude also tidies each transcript and gives it a title (sends the text to Claude)
NOTES_CLAUDE=false
# NOTES_SILENCE_STOP_S=120   # stop recording after this much quiet
# NOTES_MAX_MINUTES=30       # longest single note

# --- Optional tuning ---
# SILENCE_MS=800          # pause (ms) that marks the end of your question
# IDLE_TIMEOUT_S=10       # go back to sleep after this many seconds of silence
# CLAUDE_FILLER=Let me ask Claude.
